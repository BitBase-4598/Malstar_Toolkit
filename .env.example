# CVM listen port (waitress). Azure App Service uses the gunicorn startup command on 8000.
PORT=8080

# Optional. Defaults to backend/malstar.db (next to app.py).
# DATABASE_PATH=/absolute/path/to/malstar.db
# DATABASE_URL=sqlite:////absolute/path/to/malstar.db

# Uploaded Files/SOP attachments. On Azure keep this under /home so App Service storage persists them.
UPLOAD_DIR=/home/data/uploads

# Optional. CVM and Azure both serve frontend/dist when this is unset.
# STATIC_DIR=/absolute/path/to/frontend/dist

# Comma-separated browser origins allowed to call /api.
# Leave empty in production (same-origin). Local Vite needs localhost:5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local python app.py only. Keep false on the CVM service and on Azure.
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

MAX_UPLOAD_MB=5

# Optional. Generated Ask answers. Leave empty for keyword-only retrieval from Files and SOPs.
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-06-01
