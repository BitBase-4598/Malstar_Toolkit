# Container listen port. Azure App Service also needs WEBSITES_PORT=8080.
PORT=8080

# SQLite file. In Azure, keep this under /home so App Service storage persists it.
DATABASE_PATH=/home/data/customer_remark.db

# Built frontend. Set automatically in the Docker image.
STATIC_DIR=/app/frontend/dist

# Comma-separated browser origins allowed to call /api.
# Leave empty in production (same-origin). Local Vite needs localhost:5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local python app.py only. Always false in Docker.
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

MAX_UPLOAD_MB=5
